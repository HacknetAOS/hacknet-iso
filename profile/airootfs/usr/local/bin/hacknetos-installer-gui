import subprocess
import threading
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

SWITCH_CLI_MARKER = "/tmp/hacknetos-switch-to-cli"
INSTALLER_BIN = "/usr/local/bin/hacknetos-installer"

