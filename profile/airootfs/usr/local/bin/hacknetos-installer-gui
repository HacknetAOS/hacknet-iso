def human_size(num_bytes: int) -> str:
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if num_bytes < 1024 or unit == "TiB":
            return f"{num_bytes:.1f} {unit}" if unit != "B" else f"{num_bytes} B"
        num_bytes /= 1024
    return f"{num_bytes} B"


def detect_os_and_shrink(path: str, fstype: str, size_bytes: int):
    """Return (os_label, shrinkable_mib) for a partition."""
    fs = (fstype or "").lower()
    if fs == "swap":
        return "Linux Swap", 0
    if fs in ("vfat", "fat32", "fat16"):
        return "EFI / FAT", 0

    os_label = ""
    used_mib = None
    if fs in ("ext2", "ext3", "ext4", "btrfs", "xfs", "f2fs", "ntfs"):
        import tempfile
        mnt = tempfile.mkdtemp(prefix="hacknet-probe-")
        try:
            res = subprocess.run(["sudo", "mount", "-o", "ro", path, mnt], capture_output=True)
            if res.returncode == 0:
                try:
                    for os_rel in (os.path.join(mnt, "etc/os-release"), os.path.join(mnt, "usr/lib/os-release")):
                        if os.path.isfile(os_rel):
                            with open(os_rel, "r", errors="ignore") as f:
                                for line in f:
                                    if line.startswith("PRETTY_NAME="):
                                        os_label = line.split("=", 1)[1].strip().strip('"')
                                        break
                        if os_label:
                            break
                    if not os_label and os.path.isdir(os.path.join(mnt, "Windows/System32")):
                        os_label = "Microsoft Windows"
                    df_out = subprocess.check_output(["df", "-BM", "--output=used", mnt], text=True)
                    used_str = "".join(c for c in df_out.strip().splitlines()[-1] if c.isdigit())
                    if used_str:
                        used_mib = int(used_str)
                finally:
                    subprocess.run(["sudo", "umount", mnt], capture_output=True)
        except Exception:
            pass
        finally:
            try:
                os.rmdir(mnt)
            except OSError:
                pass

    shrink_mib = 0
    size_mib = size_bytes // (1024 * 1024)
    if fs in ("ext2", "ext3", "ext4", "ntfs", "btrfs") and used_mib is not None:
        min_safe_mib = used_mib + 1024
        if size_mib > min_safe_mib:
            shrink_mib = size_mib - min_safe_mib
    return os_label, shrink_mib


def get_largest_free_gap_mib(disk_path: str) -> int:
    try:
        out = subprocess.check_output(
            ["sudo", "parted", "-m", disk_path, "unit", "MiB", "print", "free"],
            text=True, stderr=subprocess.DEVNULL,
        )
        best = 0
        for line in out.splitlines():
            cols = line.strip().rstrip(";").split(":")
            if len(cols) >= 5 and cols[4].startswith("free"):
                s = int(float(cols[1].replace("MiB", "")))
                e = int(float(cols[2].replace("MiB", "")))
                best = max(best, e - s)
        return best
    except Exception:
        return 0


def list_disks():
    """Return list of dicts: {path, size, model, free_gap_mib, partitions: [...]}."""
    try:
        out = subprocess.check_output(
            ["lsblk", "-J", "-b", "-o", "NAME,PATH,SIZE,MODEL,TYPE,FSTYPE,LABEL,MOUNTPOINT"],
            text=True,
        )
        data = json.loads(out)
    except Exception:
        return []

    disks = []
    for dev in data.get("blockdevices", []):
        if dev.get("type") != "disk":
            continue
        name = dev.get("name", "")
        size_bytes = int(dev.get("size") or 0)
        if name.startswith(("loop", "ram", "zram", "sr", "fd")) or size_bytes < 100 * 1024 * 1024:
            continue
        dpath = dev.get("path") or f"/dev/{name}"
        parts = []
        for child in dev.get("children", []) or []:
            if child.get("type") != "part":
                continue
            ppath = child.get("path") or f"/dev/{child.get('name')}"
            psize_b = int(child.get("size") or 0)
            pfstype = child.get("fstype") or "unformatted"
            os_label, shrink_mib = detect_os_and_shrink(ppath, pfstype, psize_b)
            parts.append({
                "path": ppath,
                "size": human_size(psize_b),
                "size_mib": psize_b // (1024 * 1024),
                "fstype": pfstype,
                "label": child.get("label") or "",
                "mountpoint": child.get("mountpoint") or "",
                "os": os_label,
                "shrink_mib": shrink_mib,
            })
        disks.append({
            "path": dpath,
            "size": human_size(size_bytes),
            "model": (dev.get("model") or "Generic Disk").strip(),
            "free_gap_mib": get_largest_free_gap_mib(dpath),
            "partitions": parts,
        })
    return disks


class InstallerWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="HacknetOS Installer")
        self.set_default_size(860, 620)
        self.firmware = "UEFI" if os.path.isdir("/sys/firmware/efi") else "BIOS"
        self.disks = list_disks()
        self.selected_disk_idx = 0
        self.install_mode = "multiboot"
        self.selected_part_path = ""
        self.installing = False

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_child(root)

        # Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.add_css_class("header-bar")
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="HacknetOS Installer", xalign=0)
        title.add_css_class("title-label")
        subtitle = Gtk.Label(label="System Installation Protocol — Graphical Mode", xalign=0)
        subtitle.add_css_class("subtitle-label")
        title_box.append(title)
        title_box.append(subtitle)
        header.append(title_box)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)

        fw_badge = Gtk.Label(label=f"Firmware: {self.firmware}")
        fw_badge.add_css_class("badge")
        header.append(fw_badge)

        self.cli_btn = Gtk.Button(label="Switch to Terminal")
        self.cli_btn.add_css_class("secondary")
        self.cli_btn.connect("clicked", self.on_switch_cli)
        header.append(self.cli_btn)
        root.append(header)

        # Main stack
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_vexpand(True)
        self.stack.set_margin_top(20)
        self.stack.set_margin_bottom(20)
        self.stack.set_margin_start(28)
        self.stack.set_margin_end(28)
        root.append(self.stack)

        self._build_disk_page()
        self._build_user_page()
        self._build_review_page()
        self._build_progress_page()
        self.stack.set_visible_child_name("disk")

    def _build_disk_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class("card")
        lbl = Gtk.Label(label="1. Target Drive & Installation Mode", xalign=0)
        lbl.add_css_class("section-title")
        card.append(lbl)

        disk_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        disk_row.append(Gtk.Label(label="Target Disk:", xalign=0))
        self.disk_combo = Gtk.DropDown.new_from_strings(
            [f"{d['path']}  ({d['size']}, {d['model']})" for d in self.disks] or ["No disks found"]
        )
        self.disk_combo.set_hexpand(True)
        self.disk_combo.connect("notify::selected", self.on_disk_changed)
        disk_row.append(self.disk_combo)

        refresh_btn = Gtk.Button(label="Refresh")
        refresh_btn.add_css_class("secondary")
        refresh_btn.connect("clicked", self.on_refresh_disks)
        disk_row.append(refresh_btn)
        card.append(disk_row)

        self.parts_label = Gtk.Label(xalign=0, wrap=True)
        self.parts_label.add_css_class("muted")
        card.append(self.parts_label)

        self.mode_multiboot = Gtk.CheckButton(label="Multi-Boot / Install alongside existing OS (Recommended)")
        self.mode_clean = Gtk.CheckButton(label="Clean Install (Erase entire disk and auto-partition)")
        self.mode_clean.set_group(self.mode_multiboot)
        self.mode_multiboot.set_active(True)
        self.mode_multiboot.connect("toggled", self.on_mode_toggled)
        card.append(self.mode_multiboot)
        card.append(self.mode_clean)

        self.mb_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        strat_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        strat_row.append(Gtk.Label(label="Install Method:", xalign=0))
        self.mb_strategy_combo = Gtk.DropDown.new_from_strings(["None"])
        self.mb_strategy_combo.set_hexpand(True)
        self.mb_strategy_combo.connect("notify::selected", self.on_mb_strategy_changed)
        strat_row.append(self.mb_strategy_combo)
        self.mb_box.append(strat_row)

        self.part_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.part_label = Gtk.Label(label="Target Partition:", xalign=0)
        self.part_row.append(self.part_label)
        self.part_combo = Gtk.DropDown.new_from_strings(["None"])
        self.part_combo.set_hexpand(True)
        self.part_combo.connect("notify::selected", self.on_part_changed)
        self.part_row.append(self.part_combo)
        self.mb_box.append(self.part_row)

        self.resize_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.resize_row.append(Gtk.Label(label="HacknetOS Size (GiB):", xalign=0))
        self.resize_spin = Gtk.SpinButton.new_with_range(4, 512, 1)
        self.resize_spin.set_value(12)
        self.resize_spin.connect("value-changed", self.on_resize_changed)
        self.resize_row.append(self.resize_spin)
        self.resize_preview = Gtk.Label(xalign=0, wrap=True)
        self.resize_preview.add_css_class("muted")
        self.resize_row.append(self.resize_preview)
        self.mb_box.append(self.resize_row)

        card.append(self.mb_box)

        self.disk_warn = Gtk.Label(xalign=0, wrap=True)
        self.disk_warn.add_css_class("warn-text")
        card.append(self.disk_warn)

        box.append(card)
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        box.append(spacer)

        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        s = Gtk.Box()
        s.set_hexpand(True)
        nav.append(s)
        self.disk_next = Gtk.Button(label="Next: Account Setup →")
        self.disk_next.add_css_class("primary")
        self.disk_next.connect("clicked", lambda *_: self.stack.set_visible_child_name("user"))
        nav.append(self.disk_next)
        box.append(nav)

        self.stack.add_named(box, "disk")
        self._update_disk_details()

    def _build_user_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class("card")

        lbl = Gtk.Label(label="2. Identity & System Credentials", xalign=0)
        lbl.add_css_class("section-title")
        card.append(lbl)

        grid = Gtk.Grid(column_spacing=14, row_spacing=10)
        self.user_entry = Gtk.Entry(text="hacknet")
        self.user_entry.set_hexpand(True)
        self.pass_entry = Gtk.PasswordEntry()
        self.pass_entry.set_show_peek_icon(True)
        self.pass2_entry = Gtk.PasswordEntry()
        self.pass2_entry.set_show_peek_icon(True)
        self.host_entry = Gtk.Entry(text="hacknetos")

        rows = [
            ("Username:", self.user_entry),
            ("Password:", self.pass_entry),
            ("Confirm Password:", self.pass2_entry),
            ("Hostname:", self.host_entry),
        ]
        for i, (text, widget) in enumerate(rows):
            grid.attach(Gtk.Label(label=text, xalign=0), 0, i, 1, 1)
            grid.attach(widget, 1, i, 1, 1)
        card.append(grid)

        self.user_err = Gtk.Label(xalign=0)
        self.user_err.add_css_class("error-text")
        card.append(self.user_err)

        box.append(card)
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        box.append(spacer)

        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        back = Gtk.Button(label="← Back")
        back.add_css_class("secondary")
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("disk"))
        nav.append(back)
        s = Gtk.Box()
        s.set_hexpand(True)
        nav.append(s)
        nxt = Gtk.Button(label="Next: Review →")
        nxt.add_css_class("primary")
        nxt.connect("clicked", self.on_user_next)
        nav.append(nxt)
        box.append(nav)
        self.stack.add_named(box, "user")

    def _build_review_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class("card")

        lbl = Gtk.Label(label="3. Review Installation Summary", xalign=0)
        lbl.add_css_class("section-title")
        card.append(lbl)

        self.summary_label = Gtk.Label(xalign=0, wrap=True)
        card.append(self.summary_label)

        box.append(card)
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        box.append(spacer)

        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        back = Gtk.Button(label="← Back")
        back.add_css_class("secondary")
        back.connect("clicked", lambda *_: self.stack.set_visible_child_name("user"))
        nav.append(back)
        s = Gtk.Box()
        s.set_hexpand(True)
        nav.append(s)
        install_btn = Gtk.Button(label="Start Installation")
        install_btn.add_css_class("primary")
        install_btn.connect("clicked", self.on_start_install)
        nav.append(install_btn)
        box.append(nav)
        self.stack.add_named(box, "review")

    def _build_progress_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        self.progress_status = Gtk.Label(label="Installing HacknetOS...", xalign=0)
        self.progress_status.add_css_class("section-title")
        box.append(self.progress_status)

        self.progress_bar = Gtk.ProgressBar()
        box.append(self.progress_bar)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        self.log_view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True)
        self.log_view.add_css_class("log-view")
        scroll.set_child(self.log_view)
        box.append(scroll)

        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.exit_btn = Gtk.Button(label="Exit to Shell")
        self.exit_btn.add_css_class("secondary")
        self.exit_btn.set_sensitive(False)
        self.exit_btn.connect("clicked", lambda *_: self.get_application().quit())
        nav.append(self.exit_btn)

        s = Gtk.Box()
        s.set_hexpand(True)
        nav.append(s)

        self.reboot_btn = Gtk.Button(label="Reboot Now")
        self.reboot_btn.add_css_class("primary")
        self.reboot_btn.set_sensitive(False)
        self.reboot_btn.connect("clicked", lambda *_: subprocess.Popen(["sudo", "reboot", "-f"]))
        nav.append(self.reboot_btn)
        box.append(nav)

        self.stack.add_named(box, "progress")

    def on_switch_cli(self, *_):
        if self.installing:
            return
        with open(SWITCH_CLI_MARKER, "w") as f:
            f.write("1")
        self.get_application().quit()

    def on_refresh_disks(self, *_):
        self.disks = list_disks()
        self.disk_combo.set_model(
            Gtk.StringList.new(
                [f"{d['path']}  ({d['size']}, {d['model']})" for d in self.disks] or ["No disks found"]
            )
        )
        self._update_disk_details()

    def on_disk_changed(self, *_):
        self._update_disk_details()

    def on_mode_toggled(self, *_):
        self._update_disk_details()

    def on_mb_strategy_changed(self, *_):
        self._update_mb_controls()

    def on_part_changed(self, *_):
        self._update_mb_controls(refresh_models=False)

    def on_resize_changed(self, *_):
        self._update_resize_preview()

    def _update_resize_preview(self):
        if not getattr(self, "_mb_strategies", []):
            return
        idx = self.mb_strategy_combo.get_selected()
        if idx >= len(self._mb_strategies) or self._mb_strategies[idx][0] != "resize":
            return
        if not self._resizable_parts:
            return
        pidx = self.part_combo.get_selected()
        if pidx >= len(self._resizable_parts):
            pidx = 0
        p = self._resizable_parts[pidx]
        alloc_gib = int(self.resize_spin.get_value())
        total_gib = p["size_mib"] / 1024.0
        remain_gib = max(0.0, total_gib - alloc_gib)
        lbl = p["os"] or p["path"]
        self.resize_preview.set_text(f"{lbl}: {total_gib:.1f} → {remain_gib:.1f} GiB  |  HacknetOS: {alloc_gib} GiB")

    def _update_disk_details(self):
        if not self.disks:
            self.parts_label.set_text("No installable disks detected.")
            self.disk_next.set_sensitive(False)
            return
        idx = self.disk_combo.get_selected()
        if idx >= len(self.disks):
            idx = 0
        disk = self.disks[idx]
        parts = disk["partitions"]
        if parts:
            lines = []
            for p in parts:
                extra = [p["size"], p["fstype"]]
                if p["os"]:
                    extra.append(f"OS: {p['os']}")
                elif p["label"]:
                    extra.append(f"label={p['label']}")
                lines.append(f"  • {p['path']}  ({', '.join(extra)})")
            if disk["free_gap_mib"] >= 4096:
                lines.append(f"  • Unallocated free space: {disk['free_gap_mib'] / 1024.0:.1f} GiB")
            self.parts_label.set_text("Detected partitions:\n" + "\n".join(lines))
        else:
            self.parts_label.set_text("No existing partitions on this disk.")

        is_multi = self.mode_multiboot.get_active()
        self.mb_box.set_visible(is_multi)
        if not is_multi:
            self._mb_strategies = []
            self._non_esp_parts = []
            self._resizable_parts = []
            self.disk_warn.set_text(f"WARNING: Clean Install will ERASE ALL DATA on {disk['path']}.")
            self.disk_next.set_sensitive(True)
            return

        non_esp = [p for p in parts if p["fstype"].lower() not in ("vfat", "fat32", "fat16", "swap")]
        resizable = [p for p in non_esp if p["shrink_mib"] >= 4096]
        self._non_esp_parts = non_esp
        self._resizable_parts = resizable

        strategies = []
        if disk["free_gap_mib"] >= 4096:
            strategies.append(("free_space", f"Install into unallocated free space ({disk['free_gap_mib'] / 1024.0:.1f} GiB available)"))
        if resizable:
            strategies.append(("resize", "Shrink an existing OS/data partition to make room"))
        if non_esp:
            strategies.append(("use_part", "Format an existing partition directly (overwrites selected partition)"))
        self._mb_strategies = strategies

        if not strategies:
            self.mb_strategy_combo.set_model(Gtk.StringList.new(["No multi-boot space available — use Clean Install"]))
            self.part_row.set_visible(False)
            self.resize_row.set_visible(False)
            self.disk_warn.set_text("No free space or partitions available for Multi-Boot.")
            self.disk_next.set_sensitive(False)
            return

        self.mb_strategy_combo.set_model(Gtk.StringList.new([s[1] for s in strategies]))
        self._update_mb_controls()

    def _update_mb_controls(self, refresh_models=True):
        if not getattr(self, "_mb_strategies", []):
            return
        idx = self.mb_strategy_combo.get_selected()
        if idx >= len(self._mb_strategies):
            idx = 0
        kind = self._mb_strategies[idx][0]

        if kind == "free_space":
            self.part_row.set_visible(False)
            self.resize_row.set_visible(False)
            self.disk_warn.set_text("A new HacknetOS partition will be created in unallocated free space. Existing OSes remain untouched.")
            self.disk_next.set_sensitive(True)
        elif kind == "resize":
            self.part_row.set_visible(True)
            self.resize_row.set_visible(True)
            self.part_label.set_text("Partition to Shrink:")
            if refresh_models:
                self.part_combo.set_model(Gtk.StringList.new([
                    f"{p['path']} ({p['os'] or p['fstype']}, {p['size']}, up to {p['shrink_mib'] // 1024} GiB free)"
                    for p in self._resizable_parts
                ]))
            pidx = self.part_combo.get_selected()
            if pidx >= len(self._resizable_parts):
                pidx = 0
            max_gib = max(4, self._resizable_parts[pidx]["shrink_mib"] // 1024)
            self.resize_spin.set_range(4, max_gib)
            default_gib = min(max_gib, max(8, max_gib // 2))
            if refresh_models or self.resize_spin.get_value() > max_gib:
                self.resize_spin.set_value(default_gib)
            self._update_resize_preview()
            self.disk_warn.set_text("Selected partition will be shrunk non-destructively and a new partition created for HacknetOS.")
            self.disk_next.set_sensitive(True)
        else:
            self.part_row.set_visible(True)
            self.resize_row.set_visible(False)
            self.part_label.set_text("Partition to Format:")
            if refresh_models:
                self.part_combo.set_model(Gtk.StringList.new([
                    f"{p['path']} ({p['size']}, {p['fstype']}" + (f", OS: {p['os']}" if p["os"] else "") + ")"
                    for p in self._non_esp_parts
                ]))
            pidx = self.part_combo.get_selected()
            if pidx >= len(self._non_esp_parts):
                pidx = 0
            p = self._non_esp_parts[pidx]
            if p["os"]:
                self.disk_warn.set_text(f"WARNING: {p['path']} contains '{p['os']}'! Formatting it will ERASE that OS.")
            else:
                self.disk_warn.set_text("Selected partition will be formatted as ext4. Other partitions are preserved.")
            self.disk_next.set_sensitive(True)

    def on_user_next(self, *_):
        user = self.user_entry.get_text().strip()
        pw1 = self.pass_entry.get_text()
        pw2 = self.pass2_entry.get_text()
        host = self.host_entry.get_text().strip() or "hacknetos"
        if not user or " " in user:
            self.user_err.set_text("Please enter a valid username (no spaces).")
            return
        if not pw1:
            self.user_err.set_text("Password cannot be empty.")
            return
        if pw1 != pw2:
            self.user_err.set_text("Passwords do not match.")
            return
        self.user_err.set_text("")

        disk = self.disks[self.disk_combo.get_selected()]
        is_multi = self.mode_multiboot.get_active()
        if is_multi:
            kind = self._mb_strategies[self.mb_strategy_combo.get_selected()][0]
            if kind == "free_space":
                part = f"New partition in unallocated space ({disk['free_gap_mib'] / 1024.0:.1f} GiB)"
            elif kind == "resize":
                rp = self._resizable_parts[self.part_combo.get_selected()]
                gib = int(self.resize_spin.get_value())
                part = f"New {gib} GiB partition (shrunk from {rp['path']})"
            else:
                part = self._non_esp_parts[self.part_combo.get_selected()]["path"] + " (WILL BE FORMATTED)"
        else:
            part = "Auto-partition"
        mode_str = "Multi-Boot (Preserve other partitions)" if is_multi else "Clean Install (Erase entire disk)"
        self.summary_label.set_text(
            f"Target Disk       : {disk['path']} ({disk['size']})\n"
            f"Firmware Mode     : {self.firmware}\n"
            f"Installation Mode : {mode_str}\n"
            f"Root Partition    : {part}\n"
            f"Username          : {user}\n"
            f"Hostname          : {host}"
        )
        self.stack.set_visible_child_name("review")

    def on_start_install(self, *_):
        self.installing = True
        self.cli_btn.set_sensitive(False)
        self.stack.set_visible_child_name("progress")

        disk = self.disks[self.disk_combo.get_selected()]["path"]
        is_multi = self.mode_multiboot.get_active()
        env = os.environ.copy()
        env.update({
            "HACKNET_YES": "1",
            "HACKNET_NO_REBOOT": "1",
            "HACKNET_DISK": disk,
            "HACKNET_MODE": "multiboot" if is_multi else "clean",
            "HACKNET_USER": self.user_entry.get_text().strip(),
            "HACKNET_PASSWORD": self.pass_entry.get_text(),
            "HACKNET_HOSTNAME": self.host_entry.get_text().strip() or "hacknetos",
        })
        if is_multi:
            kind = self._mb_strategies[self.mb_strategy_combo.get_selected()][0]
            if kind == "free_space":
                env["HACKNET_USE_FREE_SPACE"] = "1"
            elif kind == "resize":
                env["HACKNET_RESIZE_PART"] = self._resizable_parts[self.part_combo.get_selected()]["path"]
                env["HACKNET_RESIZE_MB"] = str(int(self.resize_spin.get_value()) * 1024)
            else:
                env["HACKNET_PARTITION"] = self._non_esp_parts[self.part_combo.get_selected()]["path"]

        GLib.timeout_add(120, self._pulse_progress)
        threading.Thread(target=self._run_installer, args=(env,), daemon=True).start()

    def _pulse_progress(self):
        if not self.installing:
            return False
        self.progress_bar.pulse()
        return True

    def _append_log(self, line: str):
        buf = self.log_view.get_buffer()
        buf.insert(buf.get_end_iter(), line)
        mark = buf.create_mark(None, buf.get_end_iter(), False)
        self.log_view.scroll_to_mark(mark, 0.0, False, 0.0, 0.0)
        return False

    def _run_installer(self, env):
        cmd = ["sudo", "-E", INSTALLER_BIN, "--cli"]
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env
        )
        for line in proc.stdout:
            GLib.idle_add(self._append_log, line)
        rc = proc.wait()
        GLib.idle_add(self._on_install_done, rc)

    def _on_install_done(self, rc: int):
        self.installing = False
        self.exit_btn.set_sensitive(True)
        if rc == 0:
            self.progress_bar.set_fraction(1.0)
            self.progress_status.set_text("HacknetOS installation completed successfully!")
            self.progress_status.add_css_class("success-text")
            self.reboot_btn.set_sensitive(True)
        else:
            self.progress_status.set_text(f"Installation failed (exit code {rc}). See log below.")
            self.progress_status.add_css_class("error-text")
        return False


def main():
    app = Gtk.Application(application_id="org.hacknetos.installer")
    app.connect("activate", lambda a: InstallerWindow(a).present())
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())
